{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lore.result/1",
  "description": "Governed result envelope returned by every Lore read operation (MCP, HTTP, CLI).",
  "type": "object",
  "required": ["schema", "tool", "verdict", "directive", "summary", "items", "conflicts", "excluded", "budget", "links", "as_of", "constants"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "lore.result/1" },
    "decision_id": { "type": "string", "pattern": "^dec-[0-9]{4,}$" },
    "tool": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["denied", "violation", "conflict", "abstain", "ok_with_notes", "ok", "no_knowledge"] },
    "directive": { "enum": ["proceed", "proceed_and_cite", "ask_user", "stop"] },
    "summary": { "type": "string" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "intent": { "type": "string" },
        "diff_ref": { "type": "string" }
      }
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "violations": { "type": "array", "items": { "$ref": "#/$defs/violation" } },
    "excluded": { "$ref": "#/$defs/excluded" },
    "budget": {
      "type": "object",
      "required": ["limit", "used"],
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "integer", "minimum": 0 },
        "used": { "type": "integer", "minimum": 0 }
      }
    },
    "links": { "type": "array", "items": { "type": "string", "pattern": "^lore://" } },
    "data": { "type": "object" },
    "as_of": { "type": "string", "minLength": 10 },
    "constants": {
      "type": "object",
      "required": ["abstain_band", "conflict_min_conf", "token_budget", "confidence_mode"],
      "additionalProperties": false,
      "properties": {
        "abstain_band": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "conflict_min_conf": { "type": "number" },
        "token_budget": { "type": "integer" },
        "confidence_mode": { "enum": ["deterministic", "jev"] }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "kind", "role", "authority", "status", "freshness", "origin", "confidence", "text", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(rule|skill|procedure|chunk):" },
        "kind": { "enum": ["rule", "skill", "procedure", "chunk"] },
        "modality": { "enum": ["must", "must_not", "should", "may"] },
        "role": { "enum": ["applies", "constrains", "exempts", "background"] },
        "authority": { "enum": ["policy", "team_convention", "procedure", "reviewed", "unreviewed"] },
        "status": { "enum": ["stable", "unverified"] },
        "freshness": { "enum": ["current", "aging"] },
        "origin": { "enum": ["human_authored", "llm_extracted_reviewed", "git_derived", "llm_extracted"] },
        "confidence": {
          "type": "object",
          "required": ["band", "p"],
          "additionalProperties": false,
          "properties": {
            "band": { "enum": ["high", "medium"] },
            "p": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["path", "anchor"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "anchor": { "type": "string" },
            "effective_from": { "type": "string" },
            "last_verified": { "type": "string" }
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["id", "left", "right", "kind", "severity", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^conf-" },
        "left": { "type": "string" },
        "right": { "type": "string" },
        "kind": { "enum": ["direct", "partial", "stale", "authority", "extraction"] },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "scope_overlap": { "type": "string" },
        "status": { "enum": ["open", "resolved", "dismissed"] },
        "owner": { "type": "string" }
      }
    },
    "violation": {
      "type": "object",
      "required": ["rule_id", "severity", "evidence", "p"],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string" },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "p": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "excluded": {
      "type": "object",
      "required": ["superseded", "draft", "quarantine", "out_of_scope", "stale", "low_confidence", "denied"],
      "additionalProperties": false,
      "properties": {
        "superseded": { "type": "integer", "minimum": 0 },
        "draft": { "type": "integer", "minimum": 0 },
        "quarantine": { "type": "integer", "minimum": 0 },
        "out_of_scope": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 },
        "low_confidence": { "type": "integer", "minimum": 0 },
        "denied": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
