# Private working material (original brief, research notes, screenshots,
# and the separate ICAIB repository). Kept locally, never published.
archive/

# Build output
/bin/
/build/
/dist/
*.test
*.out

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc

# Setup site
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo

# Setup-site test projects (must live under the home directory)
.tmp/

# Runtime state written by `lore serve` inside example projects
examples/**/.lore/decisions/
examples/**/.lore/audit.log
examples/**/.lore/_staging/

# Local editor and agent settings at the repo root
# (examples/demo-app keeps its own .cursor/ and .vscode/ on purpose)
/.cursor/
/.vscode/
/.idea/
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
**/.lore/provider.json
